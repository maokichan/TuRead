# TuRead server 配置示例 —— 复制为 turead.toml 后按需修改
# 读取顺序：环境变量(TUREAD_*) > 本文件 > 默认值
# 详细说明见 docs/OPS.md

# ===== 启动类（改动后必须重启进程） =====
addr = ":8080"        # 监听地址（端口，或 IP:端口）
data_dir = "./data"   # 数据目录（SQLite + books/ 副本）

# ===== 策略类（改完文件 2 秒内自动生效） =====
access_token = ""              # 服务器级共享钥匙；留空 = 不启用门禁（公网务必设置）
admin_tokens = ["Abc1234"]     # 管理员 token 列表
room_ttl = "12h"               # 空房间保留时长（清理含聊天记录）
max_upload_mb = 0              # 上传大小上限 MB；0 = 不限
log_level = "info"             # 预留
