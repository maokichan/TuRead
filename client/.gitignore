# electron-vite output
out/
dist/

# electron-builder 发行版产物（安装包等；不进仓库，用 npm run dist 生成）
release/

# local dev data
*.json.tmp

# electron-vite 在 dev/build 时落下的**临时打包配置**（`electron.vite.config.<时间戳>.mjs`，
# 是配置的打包副本、不是源码；2026-09-15 发现它会以未跟踪文件出现在仓库里）
electron.vite.config.[0-9]*.mjs

# 样式样张无头核验（tools/style-gallery/smoke.cjs）落下的 Electron userData
tools/style-gallery/.smoke-user-data/

# 无头探针的独立 userData（`TUREAD_USER_DATA=<此目录>`，见 docs/STATUS.md §6）——
# 会以未跟踪目录出现在仓库里，而且会被 vite 的 watcher 当成页面刷新源（纯噪音）
.probe-user-data*/

# 蜂群机器人构建产物（npm run swarm 每次自动重建）
tools/swarm/roombot.cjs

# 探针/真机试跑的隔离 userData 与日志(运行时数据,不进仓库)
.probe/
.probe-run*.log

# ui-shot/试跑临时物
.shot-*.png
.winrect.ps1
.probe-shot/
.spike-*
.style-server.log
.probe-run*.log
